# Infrastructure / runtime template only.
# Provider credentials and routing rules are DB-managed via Admin APIs/UI.
# Legacy *_API_KEY and GATEWAY_ROUTING_CONFIG env support remains for migration.

# Server
HOST="0.0.0.0"
PORT=8082
LOG_FILE="server.log"

# Optional Anthropic-style auth token for proxy routes
ANTHROPIC_AUTH_TOKEN="freecc"

# Core model mapping (provider/model)
MODEL="nvidia_nim/z-ai/glm4.7"
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=

# Thinking defaults
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# Provider-independent runtime limits
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5

# HTTP client timeouts (seconds)
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=60
HTTP_CONNECT_TIMEOUT=60

# Gateway persistence/config
GATEWAY_STATE_DB_PATH=".config/nexus/gateway.db"
GATEWAY_STORAGE_BACKEND="sqlite"
GATEWAY_POSTGRES_DSN=""
GATEWAY_ENCRYPTION_KEY=""
GATEWAY_QUEUE_MAX_INFLIGHT=128
GATEWAY_QUEUE_MAX_QUEUED=512
GATEWAY_QUEUE_ACQUIRE_TIMEOUT_MS=30000
GATEWAY_QUEUE_BACKEND="local"
GATEWAY_REDIS_URL=""
GATEWAY_REDIS_QUEUE_PREFIX="fcc-gateway"
GATEWAY_EVENT_BUS_BACKEND="local"
GATEWAY_REDIS_EVENT_CHANNEL="fcc-gateway-events"
GATEWAY_PUBLIC_BASE_URL=""
GATEWAY_RETENTION_DAYS=14

# Optional GitHub OAuth flow for dashboard account linking
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/generative-language"
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Backward-compatible legacy routing seed (optional, one-time import to DB rules)
GATEWAY_ROUTING_CONFIG='{}'

# Messaging Platform: "telegram" | "discord" | "none"
MESSAGING_PLATFORM="discord"
MESSAGING_RATE_LIMIT=1
MESSAGING_RATE_WINDOW=1

# Voice Note Transcription
VOICE_NOTE_ENABLED=false
WHISPER_DEVICE="nvidia_nim"
WHISPER_MODEL="openai/whisper-large-v3"
HF_TOKEN=""

# Telegram Config
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_USER_ID=""

# Discord Config
DISCORD_BOT_TOKEN=""
ALLOWED_DISCORD_CHANNELS=""

# Agent Config
CLAUDE_WORKSPACE="./agent_workspace"
ALLOWED_DIR=""
CLAUDE_CLI_BIN="claude"
AGENTS_REPO_PATHS=""
AGENTS_SYNC_TARGETS=""
AGENTS_CUSTOM_ROOT=""
AGENTS_AUTODETECT_ON_STARTUP=true
AGENTS_AUTO_SYNC_ON_STARTUP=false
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true

# Local Anthropic web_search / web_fetch handling
ENABLE_WEB_SERVER_TOOLS=true
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false

# Diagnostics / logging
DEBUG_PLATFORM_EDITS=false
DEBUG_SUBAGENT_STACK=false
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false
LOG_RAW_MESSAGING_CONTENT=false
LOG_RAW_CLI_DIAGNOSTICS=false
LOG_MESSAGING_ERROR_DETAILS=false
